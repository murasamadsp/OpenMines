#!/usr/bin/env bash
# Pre-commit hook — вызывает scripts/pre-commit.sh.
# Хук живёт в .githooks/ (tracked by git) и активируется через:
#   git config core.hooksPath .githooks

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$ROOT_DIR/scripts/quality/pre-commit.sh"
